# Copie para .env.local. Nunca comite valores reais.
# Supabase (Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor
SUPABASE_SERVICE_ROLE_KEY=
# Conexão Postgres do servidor (produção: pooler em modo transação, porta 6543)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Storage: "supabase" (padrão) ou "local" (somente dev/teste; bloqueado em produção)
STORAGE_DRIVER=supabase
# IA (ADR-022). Sem AI_PROVIDER a extração fica desabilitada.
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_EXTRACTION_MODEL=claude-opus-5-5

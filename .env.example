# Copie para .env.local (dev) ou configure no provedor de hospedagem. Nunca comite valores reais.
# Validado no boot (src/lib/env.ts): em produção, configuração inválida impede a inicialização.
# Verificação manual: npm run check:env

# --- Públicas (vão para o navegador) -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Somente a chave anônima/publicável. Nunca a service role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública da aplicação (https em produção; usada em links de convite)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Somente servidor ------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
# Produção: pooler do Supabase em modo transação (porta 6543)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=5
# Segredo HMAC das intenções de upload (>= 32 caracteres). Gere com: openssl rand -hex 32
UPLOAD_SIGNING_SECRET=

# --- Extração contratual por IA (ADR-022) ---------------------------------------------------
# "anthropic" habilita a extração real; vazio desabilita (regras somente manuais).
# "deterministic-test" é um dublê de teste (regex, não é IA): só aceito com Supabase e Postgres locais.
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_EXTRACTION_MODEL=claude-opus-5-5
